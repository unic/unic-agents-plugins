#!/bin/sh
#
# pre-commit — refuse a commit whose staged content, or message, carries an NDA-protected term.
#
# WHY THIS EXISTS
#
# This repository is public. One client of the DLC work is under an NDA that forbids its name, its
# repository name, or anything that would identify it from reaching GitHub. The dangerous commit is
# not the one that types the name into its message: it is `git commit -m "<clean message>"` over a
# staged file that carries it. The message is what a reviewer reads; the diff is what is published.
#
# WHERE THE TERMS LIVE
#
# In a file OUTSIDE every repository, because a denylist that names the client is itself the leak:
#
#   $UNIC_NDA_DENYLIST, else ~/.config/unic/nda-denylist.txt   (one term per line, # for comments)
#
# This script names no term, which is why it can be committed here.
#
# WHAT IT DOES NOT PROTECT
#
# Run with no argument, it reads the added lines of the staged diff. `.githooks/commit-msg` runs it
# again with the message file, and then it reads the message. Neither run can judge a commit made
# with `--no-verify`, by `am`, `cherry-pick` or `merge`, or in another clone. `.githooks/pre-push`
# catches those when they are pushed, so this hook is an early warning. `.claude/hooks/block-nda-terms.mjs`
# covers what git never sees, such as a `gh` command that publishes an issue body.
#
# It fails CLOSED. No readable list means no commit, because a guard that waves work through when
# its own configuration is missing protects nothing. `touch` the file to opt out deliberately.
#
# INSTALL: `pnpm install` points `core.hooksPath` at the main work tree's `.githooks`, so every
# worktree of the clone runs these hooks. See `.githooks/set-hooks-path.mjs`.

set -eu

# `commit-msg` runs this file with the message file as $1, so both hooks share the lookup below.
label=pre-commit
[ $# -gt 0 ] && label=commit-msg

# The matching rule lives in nda-match.mjs, which `.githooks/nda-push.mjs` and
# `.claude/hooks/block-nda-terms.mjs` share, so the guards cannot disagree. It also reads the term list and fails closed when it cannot.
# Next to the script that runs: this file under `core.hooksPath`, or the target of a symlink that an
# older install left in `.git/hooks`. Fall back to the work tree where that symlink is a plain copy (Windows).
self=$0
if link=$(readlink "$self" 2>/dev/null); then
	case $link in
		/*) self=$link ;;
		*) self="$(dirname "$self")/$link" ;;
	esac
fi
matcher="$(dirname "$self")/nda-match.mjs"
[ -f "$matcher" ] || matcher="$(git rev-parse --show-toplevel)/.githooks/nda-match.mjs"

if [ ! -f "$matcher" ]; then
	printf '%s\n' "$label: cannot find nda-match.mjs next to this hook or in the work tree, so this commit is refused." \
		"  Check out a branch that carries .githooks/nda-match.mjs in the main work tree, then run pnpm install." >&2
	exit 1
fi

if ! command -v node >/dev/null 2>&1; then
	printf '%s\n' "$label: node is not on PATH, so the NDA guard cannot run and this commit is refused." >&2
	exit 1
fi

if [ $# -gt 0 ]; then
	node "$matcher" commit-msg "$1"
	exit
fi

# The matcher reads the staged diff itself: see readStagedDiff in nda-match.mjs.
exec node "$matcher" pre-commit
