#!/bin/sh
#
# commit-msg — refuse a commit whose message carries an NDA-protected term.
#
# `pre-commit` reads the staged diff and never sees the message, so this hook covers the message.
# Both run the same rule, in nda-match.mjs. See the header of `pre-commit` for why the guard exists.
#
# INSTALL: `pnpm install` points `core.hooksPath` at the main work tree's `.githooks`, so every
# worktree of the clone runs these hooks. See `.githooks/set-hooks-path.mjs`.

set -eu

# Next to the script that runs: this file under `core.hooksPath`, or the target of a symlink that an
# older install left in `.git/hooks`. Fall back to the work tree where that symlink is a plain copy.
self=$0
if link=$(readlink "$self" 2>/dev/null); then
	case $link in
		/*) self=$link ;;
		*) self="$(dirname "$self")/$link" ;;
	esac
fi
matcher="$(dirname "$self")/nda-match.mjs"
[ -f "$matcher" ] || matcher="$(git rev-parse --show-toplevel)/.githooks/nda-match.mjs"

if ! command -v node >/dev/null 2>&1; then
	printf '%s\n' "commit-msg: node is not on PATH, so the NDA guard cannot run and this commit is refused." >&2
	exit 1
fi

node "$matcher" commit-msg "$1"
