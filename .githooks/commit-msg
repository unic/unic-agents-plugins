#!/bin/sh
#
# commit-msg — refuse a commit whose message carries an NDA-protected term.
#
# `pre-commit` reads the staged diff and never sees the message, so this hook covers the message.
# Both run the same rule, in nda-match.mjs. See the header of `pre-commit` for why the guard exists.
#
# INSTALL: `pnpm install` points `core.hooksPath` at the main work tree's `.githooks`, so every
# worktree of the clone runs these hooks. See `.githooks/set-hooks-path.mjs`.

set -eu

# `pre-commit` checks for node and reads the message when given one. An older install may have left
# this file as a lone symlink in `.git/hooks`, where a `pre-commit` beside it is someone's own hook,
# so without the matcher here use the work tree's hooks.
dir=$(dirname "$0")
[ -f "$dir/nda-match.mjs" ] || dir="$(git rev-parse --show-toplevel)/.githooks"
if [ ! -f "$dir/pre-commit" ] || [ ! -f "$dir/nda-match.mjs" ]; then
	printf '%s\n' "commit-msg: cannot find nda-match.mjs next to this hook or in the work tree, so this commit is refused." \
		"  Run pnpm install on a branch that carries .githooks/nda-match.mjs." >&2
	exit 1
fi
exec sh "$dir/pre-commit" "$1"
