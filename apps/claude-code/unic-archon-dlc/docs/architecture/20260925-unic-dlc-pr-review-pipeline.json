{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "unic-dlc-pr-review pipeline",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "backend": {
          "label": "Prompt node"
        },
        "messagebus": {
          "label": "Script node"
        },
        "security": {
          "label": "Approval node"
        },
        "external": {
          "label": "Cancel node"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "cancel",
      "label": "Not ready",
      "variant": "exception"
    },
    {
      "id": "review",
      "label": "Prepare and review"
    },
    {
      "id": "post",
      "label": "Approve and post"
    }
  ],
  "nodes": [
    {
      "id": "bootstrap",
      "lane": "review",
      "col": 0,
      "type": "backend",
      "label": "bootstrap",
      "sublabel": "reads config",
      "width": 132
    },
    {
      "id": "guard-not-ready",
      "lane": "cancel",
      "col": 0,
      "type": "external",
      "label": "guard-not-ready",
      "sublabel": "cancels the run",
      "width": 132
    },
    {
      "id": "prep",
      "lane": "review",
      "col": 1,
      "type": "backend",
      "label": "prep",
      "sublabel": "writes intent-brief.md",
      "width": 132
    },
    {
      "id": "review",
      "lane": "review",
      "col": 2,
      "type": "backend",
      "label": "review",
      "sublabel": "writes review.json",
      "width": 132
    },
    {
      "id": "synthesize",
      "lane": "review",
      "col": 3,
      "type": "backend",
      "label": "synthesize",
      "sublabel": "writes findings.json",
      "width": 132
    },
    {
      "id": "reconcile",
      "lane": "review",
      "col": 4,
      "type": "backend",
      "label": "reconcile",
      "sublabel": "writes comment.md",
      "width": 132
    },
    {
      "id": "review-gate",
      "lane": "post",
      "col": 4,
      "type": "security",
      "label": "review-gate",
      "sublabel": "gates.pr-review: hitl",
      "width": 132
    },
    {
      "id": "post",
      "lane": "post",
      "col": 5,
      "type": "backend",
      "label": "post",
      "sublabel": "posts to the PR",
      "width": 132
    }
  ],
  "edges": [
    {
      "id": "bootstrap-prep",
      "from": "bootstrap",
      "to": "prep",
      "label": "ready"
    },
    {
      "id": "not-ready",
      "from": "bootstrap",
      "to": "guard-not-ready",
      "label": "not ready",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "prep-review",
      "from": "prep",
      "to": "review"
    },
    {
      "id": "review-synthesize",
      "from": "review",
      "to": "synthesize"
    },
    {
      "id": "synthesize-reconcile",
      "from": "synthesize",
      "to": "reconcile"
    },
    {
      "id": "reconcile-review-gate",
      "from": "reconcile",
      "to": "review-gate",
      "label": "hitl",
      "variant": "security"
    },
    {
      "id": "review-gate-post",
      "from": "review-gate",
      "to": "post",
      "label": "all_done"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Parallel",
      "items": [
        "review runs the Standards and Spec sub-agents in parallel inside one node"
      ]
    },
    {
      "dot": "cyan",
      "title": "Files",
      "items": [
        "Every file sits under <artifacts_dir>/<slug>/pr-review/",
        "reconcile also writes threads.json",
        "post updates the summary and inline threads by marker"
      ]
    },
    {
      "dot": "rose",
      "title": "Gate",
      "items": [
        "gates.pr-review: hitl pauses at review-gate; a reject cancels the run and posts nothing",
        "gates.pr-review: afk skips review-gate, and post runs because its trigger_rule is all_done"
      ]
    }
  ]
}
