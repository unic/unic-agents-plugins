  "cards": [
    {
      "dot": "emerald",
      "title": "Merge condition",
      "items": [
        "merge runs only when test is pass, e2e and coverage-gate are not fail, the PR is open, and base_ok is true",
        "guard-not-mergeable cancels on the exact negation of that condition, and merge-gate asks only when merge would run",
        "merge marks the linked items resolved, and guard-not-merged cancels when the merge did not land"
      ]
    },
    {
      "dot": "rose",
      "title": "UAT reject",
      "items": [
        "A first uat-gate reject files each defect as an agent-ready issue, which feeds /tickets",
        "The gate then pauses again, and a second reject cancels the run"
      ]
    }
  ]
